{
  "ssh_connections": [
    {
      "host": "macmini.oskar.homes",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/okwasniewski/workspace/tester-army"
          ]
        }
      ]
    }
  ],
  "agent_ui_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 450.0,
  "buffer_font_family": ".ZedMono",
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "model": "anthropic/claude-fable-5"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "claude-fable-5[1m]",
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "proxy": "",
  "context_servers": {
    "testerarmy": {
      "enabled": true,
      "url": "https://tester.army/mcp"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "enable_feedback": false,
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "sidebar_side": "left",
    "terminal_init_command": "",
    "play_sound_when_agent_done": "when_hidden",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-fable-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "vim": {
    "use_system_clipboard": "always",
  },
}
