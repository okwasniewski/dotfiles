{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "testerarmy": {
      "type": "remote",
      "url": "https://tester.army/mcp"
    },
    "testerarmy-preview": {
      "type": "remote",
      "url": "https://tester-army-git-oskar-mobile-snapshot-tester-army.vercel.app/mcp"
    },
    "supermemory": {
      "type": "remote",
      "url": "https://mcp.supermemory.ai/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPERMEMORY_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      "git push": "ask"
    },
    "doom_loop": "ask"
  }
}
